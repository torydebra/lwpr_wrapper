    def plot_test_2D_1D_model(self, x_test:np.ndarray, y_pred:np.ndarray, conf_pred:np.ndarray):

        x_test = np.asarray(x_test)
        y_pred = np.asarray(y_pred)
        conf_pred = np.asarray(conf_pred)

        if x_test.ndim != 2 or x_test.shape[1] != 2:
            raise ValueError(f'x_test must have shape (N, 2), got:{x_test.shape}')
        if y_pred.ndim != 1:
            raise ValueError(f'y_test must have shape (N, 1), got:{y_pred.shape}')
        if conf_pred.ndim != 1:
            raise ValueError(f'y_test must have shape (N,1), got:{conf_pred.shape}')
        if self.model.nIn != 2:
            raise ValueError(f'model need input of size 2 for this method, actual: {self.model.nIn}')
        if self.model.nOut != 1:
            raise ValueError(f'model need output of size 1 for this method, actual: {self.model.nOut}')                     

        # ---------------- plot ----------------
        fig = plt.figure()

        # ---- real Training values ----
        ax1 = fig.add_subplot(131, projection='3d')
        sc1 = ax1.scatter(
            self.x_train[:, 0],
            self.x_train[:, 1],
            self.y_train[:],
        )
        ax1.set_title("Real cam_yaw (train)")
        ax1.set_xlabel("X")
        ax1.set_ylabel("Y")
        ax1.set_zlabel("cam_yaw")

        # ---- real Testing values ----
        ax2 = fig.add_subplot(132, projection='3d')
        sc2 = ax2.scatter(
            self.x_test[:, 0],
            self.x_test[:, 1],
            self.y_test[:],
        )
        ax2.set_title("Real cam_yaw (test)")
        ax2.set_xlabel("X")
        ax2.set_ylabel("Y")
        ax2.set_zlabel("cam_yaw")

        # ---- predicted values ----
        ax3 = fig.add_subplot(133, projection='3d')
        sc3 = ax3.scatter(
            x_test[:, 0],
            x_test[:, 1],
            y_pred,
            c=conf_pred,
            cmap='viridis',
            s=5
        )
        ax3.set_title("LWPR predicted cam_yaw")
        ax3.set_xlabel("X")
        ax3.set_ylabel("Y")
        ax3.set_zlabel("cam_yaw")

        cbar = fig.colorbar(sc3, ax=ax3, shrink=1)
        cbar.set_label("confidence")

        plt.tight_layout()
        plt.show()
